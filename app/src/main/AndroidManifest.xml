<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: AGPL-3.0-or-later -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      No ACCESS_BACKGROUND_LOCATION: location is used while the app is on screen, or — only
      when the user switches background mode on — by a visible location foreground service.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Install-time permission for clearing and re-injecting the receiver's assistance data. -->
    <uses-permission android:name="android.permission.ACCESS_LOCATION_EXTRA_COMMANDS" />
    <!-- Install-time permission for listing nearby Wi-Fi access points on the network page. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!--
      Read-only: lets the diagnosis tell whether a data connection exists for the system's
      A-GNSS download. It grants no network access — the app has no INTERNET permission.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Background mode: a location foreground service and its notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Required, not optional: this app is a GNSS readout and has nothing to show on a
      device without a GPS receiver. Play will filter such devices out, which is intended.
    -->
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="true" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.PositioningInfo">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:exported="true"
            android:theme="@style/Theme.PositioningInfo">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".background.BackgroundTrackingService"
            android:exported="false"
            android:foregroundServiceType="location" />
    </application>

</manifest>
