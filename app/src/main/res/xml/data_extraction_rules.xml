<!--
  Nothing leaves the phone: neither Android's cloud backup nor device-to-device transfer
  copies any of the app's data (trip, first-fix log, settings). allowBackup="false" in the
  manifest covers Android 11 and older; these rules cover Android 12 and newer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
