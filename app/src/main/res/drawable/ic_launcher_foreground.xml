<!--
  A speedometer arc with its needle, orbited by a satellite: the two halves of what the
  app does. Drawn inside the 72dp adaptive-icon safe zone centred on 54,54.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Gauge arc, open at the bottom. -->
    <path
        android:pathData="M36.3,75.7 A25,25 0 1 1 71.7,75.7"
        android:strokeColor="#FF7FD1FF"
        android:strokeWidth="6"
        android:strokeLineCap="round" />

    <!-- Needle, resting where a road speed would sit. -->
    <path
        android:pathData="M54,58 L64.5,41.8"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="5"
        android:strokeLineCap="round" />

    <!-- Hub. -->
    <path
        android:pathData="M54,53 m-4.5,0 a4.5,4.5 0 1,0 9,0 a4.5,4.5 0 1,0 -9,0"
        android:fillColor="#FFFFFFFF" />

    <!-- Satellite: a single tracked signal above the gauge. -->
    <path
        android:pathData="M78,28 m-4,0 a4,4 0 1,0 8,0 a4,4 0 1,0 -8,0"
        android:fillColor="#FF7FD1FF" />
    <path
        android:pathData="M70.5,35.5 L75.2,30.8"
        android:strokeColor="#FF7FD1FF"
        android:strokeWidth="3"
        android:strokeLineCap="round" />
</vector>
